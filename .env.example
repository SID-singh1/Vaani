# Copy to .env for local runs (python scripts/dev.py) or docker compose.
# On Render, set these in the service's Environment tab instead. Never commit .env.

# --- Core -------------------------------------------------------------------------------
# production enables strict checks and Telegram webhooks
APP_ENV=development
# required in production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# empty = local SQLite (vaani.db). Production: Supabase/Neon Postgres URL
DATABASE_URL=
# enables /admin; empty = dashboard disabled
ADMIN_SECRET_KEY=
# https://your-app.onrender.com (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_BASE_URL=
LOG_LEVEL=INFO
# never log note contents unless debugging locally
LOG_TRANSCRIPTS=false

# --- Cloud engine (Groq speech-to-text + Gemini, Groq LLM as fallback) ------------------
GROQ_API_KEY=
GEMINI_API_KEY=
# LLMs tried in order (provider:model). Each has its own free quota, so capacity adds up.
LLM_CHAIN=gemini:gemini-2.5-flash,gemini:gemini-3.5-flash,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite
GROQ_ASR_MODEL=whisper-large-v3
# empty = auto-detect
GROQ_ASR_LANGUAGE=

# --- Private engine (self-hosting only; needs ~6 GB RAM) ---------------------------------
PRIVATE_ENGINE_ENABLED=false
# or "onnx" with PRIVATE_ASR_MODEL=models/whisper-small-int8
PRIVATE_ASR_BACKEND=faster-whisper
# faster-whisper size (tiny/base/small/medium) or a local path
PRIVATE_ASR_MODEL=small
PRIVATE_ASR_LANGUAGE=hi
# e.g. http://llm:8080 (docker compose) ...
LLAMA_SERVER_URL=
# ... or a llama-server binary to start on demand
LLAMA_SERVER_BIN=
# GGUF model file
PRIVATE_LLM_MODEL_PATH=
DEFAULT_ENGINE=cloud

# --- Limits that keep you inside free API tiers ------------------------------------------
USER_DAILY_NOTE_LIMIT=20
USER_BURST_LIMIT=5
USER_BURST_WINDOW_MINUTES=10
# all users combined, per rolling 24h; 0 = unlimited
GLOBAL_DAILY_CLOUD_LIMIT=300
MAX_UPLOAD_MB=20
MAX_AUDIO_SECONDS_CLOUD=1800
# comma-separated ids exempt from limits (e.g. your own tg_123)
UNLIMITED_USER_IDS=
# your own/test ids, so metrics only count real users
ANALYTICS_EXCLUDED_USER_IDS=
# 1 on Render (check /api/v1/admin/request-info after deploy)
TRUSTED_PROXY_HOPS=

# --- Telegram ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# production default: webhook. Local polling must be explicit:
# use a SEPARATE test bot token, or you'll steal the live bot's messages.
TELEGRAM_MODE=
# optional; derived from SECRET_KEY if empty
TELEGRAM_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (optional) -------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# any random string; paste the same value in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# hard cap on outgoing messages per day (cost safety)
WHATSAPP_DAILY_MESSAGE_CAP=30
